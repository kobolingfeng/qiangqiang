{
  "name": "qiangqiang",
  "version": "0.1.0",
  "description": "AI-friendly, ultra-lightweight Windows desktop app framework built with C++/Win32, WebView2, Bun, and TypeScript.",
  "license": "MIT",
  "author": "kobolingfeng",
  "homepage": "https://github.com/kobolingfeng/qiangqiang#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobolingfeng/qiangqiang.git"
  },
  "bugs": {
    "url": "https://github.com/kobolingfeng/qiangqiang/issues"
  },
  "keywords": [
    "ai-friendly",
    "windows",
    "desktop-app",
    "win32",
    "webview2",
    "typescript",
    "bun",
    "cpp"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:native": "bun scripts/build.ts --native-only",
    "build:frontend": "bun scripts/build.ts --frontend-only",
    "build:single": "bun scripts/build.ts --single-exe",
    "package": "bun scripts/package.ts",
    "package:single": "bun scripts/package.ts --single-exe"
  }
}
